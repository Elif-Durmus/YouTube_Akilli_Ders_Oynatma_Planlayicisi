<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/ice_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Gün Başlığı ve Süre Rozeti -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvGunBaslik"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1. Gün"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/slate_dark" />

            <TextView
                android:id="@+id/tvGunSureRozeti"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ice_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="1 sa 15 dk"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/slate_primary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/smoke_border"
            android:layout_marginBottom="8dp" />

        <!-- O güne ait videoların düzenli satırları buraya eklenecek -->
        <LinearLayout
            android:id="@+id/layoutGunDersleri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</androidx.cardview.widget.CardView>