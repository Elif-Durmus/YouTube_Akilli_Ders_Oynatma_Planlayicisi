<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F8F9FA">

    <!-- Üst Başlık ve Buton Çubuğu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#6200EE"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Çalışma Takvimi"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnYeniPlanYap"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="+ Yeni Plan"
            android:textColor="#6200EE"
            android:backgroundTint="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Plan Bilgi Kartı -->
    <TextView
        android:id="@+id/tvPlanOzeti"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EDE7F6"
        android:padding="14dp"
        android:text="Henüz bir çalışma planı oluşturulmadı."
        android:textColor="#4A148C"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Takvim Listesi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewTakvim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

</LinearLayout>